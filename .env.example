# Endereço do seu Chatwoot (sem barra no final)
CHATWOOT_URL=https://chat.suaempresa.com.br
# Número da conta: aparece na URL do Chatwoot -> /app/accounts/1/...
CHATWOOT_ACCOUNT_ID=1
# Token de acesso: Chatwoot -> Configurações do perfil -> Token de acesso
CHATWOOT_API_TOKEN=cole_o_token_aqui
# ID da caixa de entrada do WhatsApp: Configurações -> Caixas de entrada -> (URL termina com /inboxes/ID)
CHATWOOT_INBOX_ID=1

# Login do painel
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
# Senha secreta do webhook (qualquer texto longo e aleatório)
WEBHOOK_TOKEN=troque-por-um-texto-aleatorio-longo

# botoes = botões nativos do WhatsApp (API oficial da Meta)
# texto  = opções numeradas "1, 2, 3" (para API não oficial)
BUTTON_MODE=botoes

PORT=3000
# Pausa entre cada paciente no disparo (ms)
DISPATCH_DELAY_MS=1500
# Palavras que transferem para atendente a qualquer momento
HANDOFF_KEYWORDS=atendente,falar com atendente
